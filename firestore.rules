rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * SuguMali Security Rules
     */

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // On autorise l'accès admin par email spécifique pour le développeur en priorité
      // Puis via la collection roles_admin
      return isSignedIn() && (
        request.auth.token.email == 'sekoubtieta83@gmail.com' ||
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))
      );
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Autorisé pour permettre l'affichage des stats dans le dashboard
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
      
      // Gestion des favoris par l'utilisateur propriétaire
      match /favorites/{favId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /annonces/{annonceId} {
      allow read: if true; // Accès public pour la marketplace
      allow create: if isSignedIn() && request.resource.data.vendeurId == request.auth.uid;
      // Mise à jour autorisée par le propriétaire/admin ou pour le compteur de vues public
      allow update: if (isSignedIn() && (resource.data.vendeurId == request.auth.uid || isAdmin()))
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']));
      allow delete: if (isSignedIn() && (resource.data.vendeurId == request.auth.uid || isAdmin()));
    }

    match /promotion_requests/{requestId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow list, get, update, delete: if isAdmin();
    }

    match /roles_admin/{adminId} {
      allow get: if isSignedIn();
      allow list, create, update, delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow create: if isSignedIn();
      allow list, get: if isAdmin();
    }
    
    match /searchLogs/{logId} {
      allow create: if true;
      allow list: if isAdmin();
    }
    
    match /rateLimits/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
  }
}
