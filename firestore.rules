rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * SuguMali Security Rules
     */

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
      
      // Gestion des favoris par l'utilisateur propriétaire
      match /favorites/{favId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /annonces/{annonceId} {
      allow read: if true; // Public read access for the marketplace
      allow create: if isSignedIn() && request.resource.data.vendeurId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.vendeurId == request.auth.uid) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.vendeurId == request.auth.uid) || isAdmin();
    }

    match /promotion_requests/{requestId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow list, get, update, delete: if isAdmin();
    }

    match /roles_admin/{adminId} {
      allow get: if isSignedIn();
      allow list, create, update, delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow create: if isSignedIn();
      allow list, get: if isAdmin();
    }
    
    match /searchLogs/{logId} {
      allow create: if true;
      allow list: if isAdmin();
    }
    
    match /rateLimits/{userId} {
      allow get, write: if isOwner(userId);
    }
  }
}