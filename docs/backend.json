{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Compte utilisateur SuguMali.",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "isVerified": { "type": "boolean" },
        "isBanned": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "isVerified"]
    },
    "Annonce": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Annonce",
      "type": "object",
      "description": "Une annonce publiée sur la marketplace.",
      "properties": {
        "id": { "type": "string" },
        "vendeurId": { "type": "string" },
        "titre": { "type": "string" },
        "description": { "type": "string" },
        "prix": { "type": "string" },
        "categorie": { "type": "string" },
        "localisation": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "isPromoted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["vendeurId", "titre", "prix", "status"]
    },
    "PromotionRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PromotionRequest",
      "type": "object",
      "description": "Demande de boost pour une annonce.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "annonceId": { "type": "string" },
        "screenshotUrl": { "type": "string", "format": "uri" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "annonceId", "screenshotUrl", "status"]
    }
  },
  "auth": {
    "providers": ["password", "google", "phone"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "description": "Profils utilisateurs."
        }
      },
      {
        "path": "/annonces/{annonceId}",
        "definition": {
          "entityName": "Annonce",
          "description": "Annonces publiques."
        }
      },
      {
        "path": "/promotion_requests/{requestId}",
        "definition": {
          "entityName": "PromotionRequest",
          "description": "Demandes de promotion (root collection pour accès admin facilité)."
        }
      },
      {
        "path": "/roles_admin/{adminId}",
        "definition": {
          "entityName": "User",
          "description": "Droits administrateurs."
        }
      }
    ]
  }
}